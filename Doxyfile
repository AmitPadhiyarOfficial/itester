# Doxyfile for the itester .NET API documentation.
# Generate with: doxygen Doxyfile

PROJECT_NAME           = "itester .NET API"
PROJECT_BRIEF          = "API reference for the four-operation calculator"
OUTPUT_DIRECTORY       = docs/doxygen

INPUT                  = Program.cs
FILE_PATTERNS          = *.cs
RECURSIVE              = NO

OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_AS_ERROR          = NO

# Keep generated output out of source control; regenerate it as needed.
